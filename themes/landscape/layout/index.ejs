<%
  // Hexo gives page.posts as a special collection (not always a plain Array).
  // Convert to Array defensively, then render sticky posts first.
  const posts = page.posts;
  const arr = (posts && typeof posts.toArray === 'function')
    ? posts.toArray()
    : (posts && posts.data ? posts.data : (posts || []));

  const isSticky = (p) => p && p.sticky && p.sticky > 0;

  const sticky = arr
    .filter(isSticky)
    .sort((a, b) => (b.sticky || 0) - (a.sticky || 0) || (b.date - a.date));

  const normal = arr.filter(p => !isSticky(p));
  const ordered = sticky.concat(normal);
%>

<% ordered.forEach(function(post, i){ %>
  <%- partial('_partial/archive-post', {post: post, even: i % 2 === 0, index: true}) %>
<% }) %>

<% if (page.total > 1){ %>
  <nav id="page-nav">
    <% var prev_text = "&laquo; " + __('prev');var next_text = __('next') + " &raquo;"%>
    <%- paginator({ prev_text: prev_text, next_text: next_text, escape: false }) %>
  </nav>
<% } %>
